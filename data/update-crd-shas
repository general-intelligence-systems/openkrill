#!/usr/bin/env ruby
# frozen_string_literal: true

# Populates/updates crd_last_sha and crd_last_updated columns in data/crds.csv
# by querying the GitHub API for the latest commit touching each repo's crd_path.
#
# Usage: bin/update-crd-shas
#
# On first run: adds the two columns.
# On re-run: updates them and prints any rows where the SHA changed.

require "csv"
require "open3"

CSV_PATH = File.join(__dir__, "..", "data", "crds.csv")

table = CSV.read(CSV_PATH, headers: true)

# Ensure columns exist
unless table.headers.include?("crd_last_sha")
  table.each { |r| r["crd_last_sha"] = nil }
end
unless table.headers.include?("crd_last_updated")
  table.each { |r| r["crd_last_updated"] = nil }
end

# Cache: "repo_url|crd_path" -> {sha:, date:}
# Avoids duplicate API calls when multiple CSV rows share the same repo+path.
cache = {}
changed = []
total = table.count { |r| r["crd_path"] && !r["crd_path"].empty? }
count = 0

table.each do |row|
  crd_path = row["crd_path"]
  next if crd_path.nil? || crd_path.empty?

  repo_url = row["repo_url"]
  cache_key = "#{repo_url}|#{crd_path}"
  count += 1

  unless cache.key?(cache_key)
    owner_repo = repo_url.sub("https://github.com/", "")
    $stderr.print "[#{count}/#{total}] #{owner_repo} #{crd_path} ... "

    stdout, status = Open3.capture2(
      "gh", "api",
      "repos/#{owner_repo}/commits?path=#{crd_path}&per_page=1",
      "--jq", '.[0] | .sha + "\t" + .commit.committer.date'
    )

    if status.success? && !stdout.strip.empty?
      sha, date = stdout.strip.split("\t", 2)
      cache[cache_key] = { sha: sha, date: date }
      $stderr.puts sha[0..6]
    else
      cache[cache_key] = { sha: "", date: "" }
      $stderr.puts "FAILED"
    end
  end

  result = cache[cache_key]
  old_sha = row["crd_last_sha"]

  if old_sha && !old_sha.empty? && old_sha != result[:sha]
    changed << {
      repo: repo_url.sub("https://github.com/", ""),
      schema: row["schema_name"],
      old: old_sha[0..6],
      new: result[:sha][0..6]
    }
  end

  row["crd_last_sha"] = result[:sha]
  row["crd_last_updated"] = result[:date]
end

# Write back
CSV.open(CSV_PATH, "w") do |csv|
  csv << table.headers
  table.each { |row| csv << row }
end

# Summary
$stderr.puts "\nDone. #{count} rows checked."
if changed.any?
  $stderr.puts "\n#{changed.size} CRDs updated since last run:"
  changed.each do |c|
    $stderr.puts "  #{c[:schema]} (#{c[:repo]}): #{c[:old]} -> #{c[:new]}"
  end
elsif table.any? { |r| r["crd_last_sha"] && !r["crd_last_sha"].empty? }
  $stderr.puts "No changes detected."
end

#!/usr/bin/env bash
set -euo pipefail

# Fetches CRD YAML files from a GitHub directory, strips Helm template
# directives, and generates one typed .nix fragment per CRD kind.
# A crds.nix is then generated that imports all the per-CRD files.
#
# Usage: bin/generate-bitnami-crds <module-name> <github-tree-url>

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

STABLE=false
POSITIONAL=()
for arg in "$@"; do
  case "$arg" in
    --stable) STABLE=true ;;
    *)        POSITIONAL+=("$arg") ;;
  esac
done
set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"

if [[ $# -lt 2 ]]; then
  echo "Usage: bin/generate-bitnami-crds <module-name> <github-tree-url> [--stable]" >&2
  exit 1
fi

MODULE_NAME="$1"
APPS_DIR="${SCRIPT_DIR}/apps/unstable"
$STABLE && APPS_DIR="${SCRIPT_DIR}/apps/stable"
MODULE_DIR="${APPS_DIR}/${MODULE_NAME}"
TMPDIR=$(mktemp -d)
trap "rm -rf '$TMPDIR'" EXIT
GENERATED_FILES=()

[[ -d "$MODULE_DIR" ]] || { echo "${MODULE_DIR} does not exist" >&2; exit 1; }

# ── Functions ──────────────────────────────────────────────────────

format_nix() {
  nix run nixpkgs#nixfmt -- "$1" 2>/dev/null || true
}

# Download CRD YAMLs from a GitHub tree URL, strip Helm directives,
# and split multi-doc YAMLs into individual <plural>.yaml files in $TMPDIR.
retrieve_files() {
  local tree_url="$1"

  read -r owner repo ref dir_path <<< "$(echo "$tree_url" | ruby -e '
    m = STDIN.read.strip.match(%r{github\.com/([^/]+)/([^/]+)/tree/([^/]+)/(.+)})
    abort "Cannot parse URL" unless m
    puts "#{m[1]} #{m[2]} #{m[3]} #{m[4]}"
  ')"

  local urls
  urls=$(curl -sf "https://api.github.com/repos/${owner}/${repo}/contents/${dir_path}?ref=${ref}" \
    | ruby -rjson -e '
      JSON.parse(STDIN.read)
        .select { |f| f["name"].end_with?(".yaml", ".yml") && f["type"] == "file" }
        .each { |f| puts f["download_url"] }
    ' 2>/dev/null) || urls=""

  [[ -z "$urls" ]] && return

  for url in $urls; do
    curl -sf "$url" | ruby -e '
      STDIN.each_line do |line|
        next if line.strip =~ /^\{\{-?\s*(if|else|end|range|with|define|template|block|include)/
        puts line.gsub(/\{\{.*?\}\}/, "")
      end
    ' > "${TMPDIR}/crd.yaml"

    ruby -ryaml -e '
      YAML.load_stream(File.read(ARGV[0])).each do |doc|
        next unless doc.is_a?(Hash) && doc["kind"] == "CustomResourceDefinition"
        plural = doc.dig("spec", "names", "plural")
        next unless plural
        File.write(File.join(ARGV[1], "#{plural.downcase}.yaml"), YAML.dump(doc))
      end
    ' "${TMPDIR}/crd.yaml" "$TMPDIR" 2>/dev/null || true

    rm -f "${TMPDIR}/crd.yaml"
  done
}

# Generate a single .nix fragment from a CRD YAML file.
create_crd() {
  local crd_yaml="$1"
  local name
  name=$(basename "$crd_yaml" .yaml)

  local nix_file="${MODULE_DIR}/${name}.nix"
  local tmp_nix="${TMPDIR}/${name}.nix"

  if "${SCRIPT_DIR}/bin/create-module-crds" --fragment "$MODULE_NAME" "$crd_yaml" \
      > "$tmp_nix" 2>/dev/null; then
    format_nix "$tmp_nix"
    mv "$tmp_nix" "$nix_file"
    GENERATED_FILES+=("${name}.nix")
    echo "  ${MODULE_NAME}/${name}"
  else
    rm -f "$tmp_nix"
    echo "  ${MODULE_NAME}/${name} (failed)" >&2
  fi
}

# Remove stale per-CRD .nix files from previous runs.
cleanup_old_nix() {
  local keep=(default.nix values.nix crds.nix custom.nix)

  for existing in "${MODULE_DIR}"/*.nix; do
    [[ -f "$existing" ]] || continue
    local fname
    fname=$(basename "$existing")

    local skip=false
    for k in "${keep[@]}"; do [[ "$fname" == "$k" ]] && skip=true && break; done
    $skip && continue

    local found=false
    for gen in "${GENERATED_FILES[@]}"; do [[ "$fname" == "$gen" ]] && found=true && break; done
    $found || rm -f "$existing"
  done
}

# Write crds.nix with sorted imports.
create_crd_index() {

  {
    echo "# Auto-generated — imports per-CRD fragment modules."
    echo "# Regenerate: bin/generate-bitnami-crds ${MODULE_NAME} <url>"
    echo "{"
    echo "  imports = ["
    IFS=$'\n' sorted=($(sort <<<"${GENERATED_FILES[*]}")); unset IFS
    for f in "${sorted[@]}"; do echo "    ./${f}"; done
    echo "  ];"
    echo "}"
  } > "${MODULE_DIR}/crds.nix"

  format_nix "${MODULE_DIR}/crds.nix"
  git -C "$SCRIPT_DIR" add -f "${MODULE_DIR}/" 2>/dev/null || true
}

# ── Main ───────────────────────────────────────────────────────────

retrieve_files "$2"

for crd_yaml in "$TMPDIR"/*.yaml; do
  [[ -f "$crd_yaml" ]] || continue
  create_crd "$crd_yaml"
done

cleanup_old_nix
create_crd_index

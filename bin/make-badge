#!/usr/bin/env nix-shell
#! nix-shell -i bash -p imagemagick liberation_ttf

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASSETS_DIR="$SCRIPT_DIR/../assets"

INPUT="$ASSETS_DIR/logo-circle.png"
OUTPUT="$ASSETS_DIR/openkrill-approved-badge.png"

if [[ ! -f "$INPUT" ]]; then
  echo "Error: $INPUT not found (run bin/make-logo-circle first)" >&2
  exit 1
fi

HEIGHT=100
PADDING=12
RADIUS=16
LOGO_SIZE=$((HEIGHT - PADDING * 2))
BG_COLOR="#1a1a2e"
TEXT_COLOR="#e0e0e0"
ACCENT_COLOR="#5277C3"
FONT=$(find /nix/store -name 'LiberationSans-Bold.ttf' 2>/dev/null | head -1)

# Resize the circle logo to fit inside the badge
magick "$INPUT" -resize "${LOGO_SIZE}x${LOGO_SIZE}" /tmp/ok-badge-logo.png

# Measure text width so we can size the badge properly
TEXT_WIDTH=$(magick -size "1x1" xc:none \
  -font "$FONT" -pointsize 28 \
  -annotate 0 "openkrill approved" \
  -format "%[fx:u.w]" info: 2>/dev/null || echo 320)

# If we can't measure, use a sensible fallback
if [[ "$TEXT_WIDTH" -lt 100 ]]; then
  TEXT_WIDTH=320
fi

BADGE_WIDTH=$((PADDING + LOGO_SIZE + PADDING + TEXT_WIDTH + PADDING * 2))

# Create the badge background (rounded rectangle)
magick -size "${BADGE_WIDTH}x${HEIGHT}" xc:none \
  -fill "$BG_COLOR" \
  -draw "roundrectangle 0,0 $((BADGE_WIDTH-1)),$((HEIGHT-1)) $RADIUS $RADIUS" \
  /tmp/ok-badge-bg.png

# Draw accent stripe on the left side behind the logo
STRIPE_WIDTH=$((LOGO_SIZE + PADDING * 2))
magick /tmp/ok-badge-bg.png \
  -fill "$ACCENT_COLOR" \
  -draw "roundrectangle 0,0 $((STRIPE_WIDTH-1)),$((HEIGHT-1)) $RADIUS $RADIUS" \
  -fill "$BG_COLOR" \
  -draw "rectangle $((STRIPE_WIDTH - RADIUS)),0 $((STRIPE_WIDTH-1)),$((HEIGHT-1))" \
  /tmp/ok-badge-bg.png

# Composite: logo on the accent stripe
magick /tmp/ok-badge-bg.png \
  /tmp/ok-badge-logo.png -geometry "+${PADDING}+${PADDING}" -composite \
  /tmp/ok-badge-composed.png

# Add text
TEXT_X=$((STRIPE_WIDTH + PADDING))
magick /tmp/ok-badge-composed.png \
  -font "$FONT" -pointsize 28 \
  -fill "$TEXT_COLOR" \
  -gravity West \
  -annotate "+${TEXT_X}+0" "openkrill approved" \
  "$OUTPUT"

# Cleanup
rm -f /tmp/ok-badge-logo.png /tmp/ok-badge-bg.png /tmp/ok-badge-composed.png

echo "Created $OUTPUT (${BADGE_WIDTH}x${HEIGHT})"
